# Copy to .env. Leave DATABASE_URL unset to use local SQLite (dev.db).
# Supabase: Project Settings > Database > Connection string > Session pooler (port 5432)
DATABASE_URL=
CORS_ORIGINS=http://localhost:3000

# AI / partner keys — server side only, never commit real values
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
