# Copy to .env. Leave DATABASE_URL unset to use local SQLite (dev.db).
# Supabase: Project Settings > Database > Connection string > Session pooler (port 5432)
DATABASE_URL=
CORS_ORIGINS=http://localhost:3000

# Server side only, never commit real values
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Stripe test key (sk_test_...), account country Thailand, PromptPay enabled
STRIPE_SECRET_KEY=
ELEVENLABS_API_KEY=
# Bot voice for /api/voice/speak. Default Daniel (onwK4e9ZLuTAKqWW03F9); Eric is cjVigY5qzO86Huf0OWal
ELEVENLABS_VOICE_ID=
