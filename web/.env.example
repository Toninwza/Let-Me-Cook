# Copy to .env.local. URL of the FastAPI service (no trailing slash).
API_URL=http://localhost:8000

# Supabase Auth (Project Settings > API). The anon key is public by design; RLS keeps tables closed.
# These are baked in at build time, so a Docker build needs them as build args.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
